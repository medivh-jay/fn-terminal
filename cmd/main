#!/usr/bin/env bash
set -euo pipefail
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
# BEGIN ROOT TRUST PREFLIGHT
# Embedded into each lifecycle callback; no unvalidated helper is sourced as root.
# fnOS's protected lifecycle dispatcher is the initial trust boundary.
require_trusted_path() {
  local original="$1" parent_mode="${2:-}" resolved start node metadata owner mode
  [[ "$original" == /* ]] || {
    TASK_TRUST_ERROR="路径不是绝对路径：$original"
    return 1
  }
  resolved="$(readlink -e -- "$original")" || {
    TASK_TRUST_ERROR="路径不存在或无法解析：$original"
    return 1
  }
  for start in "$original" "$resolved"; do
    node="$start"
    while :; do
      if [[ -L "$node" && "$(stat -c '%u' -- "$node")" != 0 ]]; then
        TASK_TRUST_ERROR="符号链接不是 root 所有：$node"
        return 1
      fi
      metadata="$(stat -Lc '%u %a' -- "$node")" || {
        TASK_TRUST_ERROR="无法读取路径权限：$node"
        return 1
      }
      read -r owner mode <<<"$metadata"
      [[ "$owner" == 0 && "$mode" =~ ^[0-7]+$ ]] || {
        TASK_TRUST_ERROR="路径不是 root 所有：$node (uid=$owner)"
        return 1
      }
      if (((8#$mode & 8#022) != 0)); then
        # Sticky root-owned ancestors protect their root-owned child entries.
        # Do not accept a public directory as the protected object itself.
        if [[ ! -d "$node" ]] || (((8#$mode & 8#1000) == 0)) || [[ "$node" == "$start" && "$parent_mode" != directory-parent ]]; then
          TASK_TRUST_ERROR="路径可被非 root 用户写入：$node (mode=$mode)"
          return 1
        fi
      fi
      [[ "$node" == / ]] && break
      node="$(dirname -- "$node")"
    done
  done
}
require_optional_regular() {
  if [[ -e "$1" || -L "$1" ]]; then
    [[ -f "$1" && ! -L "$1" ]] || {
      TASK_TRUST_ERROR="运行文件不是普通文件或是符号链接：$1"
      return 1
    }
    require_trusted_path "$1" || return 1
  fi
}
secure_data_directory() {
  local original="$1" resolved owner package_uid parent_mode=''
  [[ "$original" == /* ]] || {
    TASK_TRUST_ERROR="数据目录不是绝对路径：$original"
    return 1
  }
  resolved="$(readlink -e -- "$original")" || {
    TASK_TRUST_ERROR="数据目录不存在：$original"
    return 1
  }
  [[ -d "$resolved" ]] || {
    TASK_TRUST_ERROR="数据路径不是目录：$original"
    return 1
  }
  if [[ -L "$original" && "$(stat -c '%u' -- "$original")" != 0 ]]; then
    TASK_TRUST_ERROR="数据目录链接不是 root 所有：$original"
    return 1
  fi
  owner="$(stat -c '%u' -- "$resolved")" || return 1
  package_uid="$(id -u "${TRIM_USERNAME:?}")" || {
    TASK_TRUST_ERROR="应用用户不存在：$TRIM_USERNAME"
    return 1
  }
  [[ "$owner" == 0 || "$owner" == "$package_uid" ]] || {
    TASK_TRUST_ERROR="数据目录不属于 root 或应用用户：$resolved (uid=$owner)"
    return 1
  }
  # Only a root-owned entry is safe to adopt under a public sticky parent.
  [[ "$owner" != 0 ]] || parent_mode=directory-parent
  require_trusted_path "$(dirname -- "$original")" "$parent_mode" || return 1
  require_trusted_path "$(dirname -- "$resolved")" "$parent_mode" || return 1
  # Take ownership only of these data directories, never executable content or shared ancestors.
  chown "root:${TRIM_GROUPNAME:?}" "$resolved" || return 1
  chmod 0750 "$resolved" || return 1
  require_trusted_path "$original"
}
trust_fail() {
  echo "${TASK_TRUST_ERROR:-拒绝不可信的特权启动路径或运行文件。}" >&2
  exit 1
}
lifecycle_log_record() {
  local task_event="$1" task_detail="$2" task_saved_error="${TASK_TRUST_ERROR:-}" task_record task_fixed_log=/var/log/fnterminal-install.log
  printf -v task_record '%s [%s] %s: %s' "$(date -Is)" "$task_event" "${task_lifecycle_script:-unknown}" "${task_detail:0:4096}"
  # This root-protected path survives rollback of /var/apps/fnterminal. Never
  # follow a log symlink or trust a file created by an unprivileged account.
  if [[ "$(id -u)" == 0 ]] && require_trusted_path /var/log; then
    if [[ ! -e "$task_fixed_log" && ! -L "$task_fixed_log" ]]; then (
      umask 077
      set -o noclobber
      : >"$task_fixed_log"
    ) 2>/dev/null || true; fi
    if [[ -f "$task_fixed_log" && ! -L "$task_fixed_log" ]] && require_trusted_path "$task_fixed_log" && [[ "$(stat -c '%a' -- "$task_fixed_log")" == 600 ]]; then
      printf '%s\n' "$task_record" >>"$task_fixed_log" || true
    fi
  fi
  if command -v logger >/dev/null 2>&1; then logger -t fnterminal-install -- "$task_record" 2>/dev/null || true; fi
  TASK_TRUST_ERROR="$task_saved_error"
  return 0
}
lifecycle_on_exit() {
  local task_status="$1" task_line="$2" task_message task_log="${TRIM_TEMP_LOGFILE:-}"
  if [[ "$task_status" == 0 ]]; then
    if [[ "${task_lifecycle_script:-}" != main || "${task_lifecycle_action:-}" != status ]]; then lifecycle_log_record OK "${TASK_PHASE:-执行回调} 已完成" || true; fi
    return 0
  fi
  if [[ "${task_lifecycle_script:-}" == main && "${task_lifecycle_action:-}" == status && "$task_status" == 3 ]]; then return 0; fi
  trap - EXIT
  set +e
  task_message="飞牛终端回调 ${task_lifecycle_script:-unknown} 失败：${TASK_PHASE:-执行回调}；行 $task_line，退出码 $task_status。${TASK_TRUST_ERROR:-}"
  printf '%s\n' "$task_message" >&2
  lifecycle_log_record FAIL "$task_message" || true
  # The platform supplies this path. Reject symlinks and unsafe parents; create
  # an absent root-owned error file exclusively before publishing diagnostics.
  if [[ -n "$task_log" && "$task_log" == /* ]] && require_trusted_path "$(dirname -- "$task_log")" directory-parent; then
    if [[ ! -e "$task_log" && ! -L "$task_log" ]]; then (
      umask 077
      set -o noclobber
      : >"$task_log"
    ) 2>/dev/null; fi
    if [[ -f "$task_log" && ! -L "$task_log" ]] && require_trusted_path "$task_log"; then
      printf '%s\n' "$task_message" >"$task_log"
    fi
  fi
  exit "$task_status"
}
task_lifecycle_script="${BASH_SOURCE[0]##*/}"
task_lifecycle_action="${1:-}"
TASK_PHASE=验证回调执行路径
TASK_TRUST_ERROR=''
trap 'lifecycle_on_exit "$?" "$LINENO"' EXIT
task_lifecycle_path="${BASH_SOURCE[0]}"
[[ "$task_lifecycle_path" == /* ]] || task_lifecycle_path="$(pwd -P)/$task_lifecycle_path"
if [[ "$task_lifecycle_script" != main || "$task_lifecycle_action" != status ]]; then
  # Only integration context is logged, never the full environment or credentials.
  printf -v task_lifecycle_context 'uid=%q bash=%q script=%q app_user=%q app_group=%q appdest=%q etc=%q var=%q fnos=%q' "$(id -u)" "$BASH_VERSION" "$task_lifecycle_path" "${TRIM_USERNAME:-<unset>}" "${TRIM_GROUPNAME:-<unset>}" "${TRIM_APPDEST:-<unset>}" "${TRIM_PKGETC:-<unset>}" "${TRIM_PKGVAR:-<unset>}" "${TRIM_SYS_VERSION:-<unset>}"
  lifecycle_log_record BEGIN "$task_lifecycle_context" || true
fi
require_trusted_path "$task_lifecycle_path" || trust_fail
# Restore a known payload from SDK group-writable extraction defaults without
# executing or promoting an unverified inode. Pins live in the trusted callback.
secure_payload_directory() {
  local path="$1" package_uid="$2" owner mode
  [[ -d "$path" && ! -L "$path" ]] || {
    TASK_TRUST_ERROR="程序目录不是普通目录或是符号链接：$path"
    return 1
  }
  read -r owner mode < <(stat -c '%u %a' -- "$path") || return 1
  [[ "$owner" == 0 || "$owner" == "$package_uid" ]] || {
    TASK_TRUST_ERROR="程序目录所有者异常：$path"
    return 1
  }
  (((8#$mode & 8#002) == 0)) || {
    TASK_TRUST_ERROR="程序目录允许所有用户写入：$path"
    return 1
  }
  chown root:root "$path" && chmod 0755 "$path" && require_trusted_path "$path"
}
cleanup_payload_workspace() {
  local directory="$1" file
  [[ -d "$directory" && ! -L "$directory" ]] || return 0
  for file in "$directory"/copy.*; do
    if [[ -f "$file" && ! -L "$file" ]]; then unlink "$file" || true; fi
  done
  rmdir "$directory" 2>/dev/null || true
  return 0
}
prepare_app_payload() {
  local original="${TRIM_APPDEST:?}" root package_uid owner mode parent_mode='' entry digest final_mode size relative directory component source temporary actual workspace i
  local -a copies=() destinations=() modes=() parts=()
  if ! declare -p FNTERMINAL_PAYLOAD_PINS >/dev/null 2>&1 || ((${#FNTERMINAL_PAYLOAD_PINS[@]} == 0 || ${#FNTERMINAL_PAYLOAD_PINS[@]} > 128)); then
    TASK_TRUST_ERROR=安装包缺少有效的程序完整性校验信息
    return 1
  fi
  [[ "$original" == /* ]] || {
    TASK_TRUST_ERROR="程序目录不是绝对路径：$original"
    return 1
  }
  root="$(readlink -e -- "$original")" || return 1
  if [[ -L "$original" && "$(stat -c '%u' -- "$original")" != 0 ]]; then
    TASK_TRUST_ERROR="程序目录链接不是 root 所有：$original"
    return 1
  fi
  [[ -d "$root" && ! -L "$root" ]] || return 1
  package_uid="$(id -u "${TRIM_USERNAME:?}")" || return 1
  owner="$(stat -c '%u' -- "$root")" || return 1
  [[ "$owner" != 0 ]] || parent_mode=directory-parent
  require_trusted_path "$(dirname -- "$original")" "$parent_mode" || return 1
  require_trusted_path "$(dirname -- "$root")" "$parent_mode" || return 1
  secure_payload_directory "$root" "$package_uid" || return 1
  workspace="$(mktemp -d "$root/.verified.XXXXXXXX")" || return 1
  for entry in "${FNTERMINAL_PAYLOAD_PINS[@]}"; do
    IFS=: read -r digest final_mode size relative <<<"$entry"
    if [[ ! "$digest" =~ ^[0-9a-f]{64}$ || ! "$size" =~ ^[0-9]{1,8}$ || ! "$relative" =~ ^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$ || "/$relative/" == */../* || "/$relative/" == */./* ]] || ((10#$size > 67108864)) || [[ "$final_mode" != 0644 && "$final_mode" != 0755 ]]; then
      TASK_TRUST_ERROR=安装包程序校验信息无效
      cleanup_payload_workspace "$workspace"
      return 1
    fi
    directory="$root"
    IFS=/ read -r -a parts <<<"$relative"
    for ((i = 0; i < ${#parts[@]} - 1; i++)); do
      component="${parts[i]}"
      directory="$directory/$component"
      if ! secure_payload_directory "$directory" "$package_uid"; then
        cleanup_payload_workspace "$workspace"
        return 1
      fi
    done
    source="$root/$relative"
    if [[ ! -f "$source" || -L "$source" ]]; then
      TASK_TRUST_ERROR="程序文件不是普通文件或是符号链接：$source"
      cleanup_payload_workspace "$workspace"
      return 1
    fi
    read -r owner mode < <(stat -c '%u %a' -- "$source") || {
      cleanup_payload_workspace "$workspace"
      return 1
    }
    if [[ "$owner" != 0 && "$owner" != "$package_uid" ]] || (((8#$mode & 8#002) != 0)); then
      TASK_TRUST_ERROR="程序文件所有者或写权限异常：$source"
      cleanup_payload_workspace "$workspace"
      return 1
    fi
    temporary="$(mktemp "$workspace/copy.XXXXXXXX")" || {
      cleanup_payload_workspace "$workspace"
      return 1
    }
    # Bound reads by the trusted expected size; hash only the new private inode.
    if ! head -c "$((10#$size + 1))" -- "$source" >"$temporary"; then
      TASK_TRUST_ERROR="无法复制程序文件：$source"
      cleanup_payload_workspace "$workspace"
      return 1
    fi
    actual="$(sha256sum -- "$temporary")" || {
      cleanup_payload_workspace "$workspace"
      return 1
    }
    if [[ "${actual%% *}" != "$digest" || "$(stat -c '%s' -- "$temporary")" != "$size" ]]; then
      TASK_TRUST_ERROR="程序文件 SHA-256 校验失败：$source"
      cleanup_payload_workspace "$workspace"
      return 1
    fi
    copies+=("$temporary")
    destinations+=("$source")
    modes+=("$final_mode")
  done
  # Verify the entire bundle before publishing any replacement or executing code.
  for ((i = 0; i < ${#copies[@]}; i++)); do
    if ! chown root:root "${copies[i]}" || ! chmod "${modes[i]}" "${copies[i]}" || ! mv -fT -- "${copies[i]}" "${destinations[i]}"; then
      TASK_TRUST_ERROR="无法发布已校验程序：${destinations[i]}"
      cleanup_payload_workspace "$workspace"
      return 1
    fi
  done
  cleanup_payload_workspace "$workspace"
  require_trusted_path "$original/bin/fn-terminal" && require_trusted_path "$original/config.example.json"
}
# END ROOT TRUST PREFLIGHT
umask 077
: "${TRIM_APPDEST:?}" "${TRIM_PKGETC:?}" "${TRIM_PKGVAR:?}" "${TRIM_USERNAME:?}"
binary="$TRIM_APPDEST/bin/fn-terminal"
pidfile="$TRIM_PKGVAR/supervisor.pid"
for task_path in "$binary" "$TRIM_APPDEST" "$TRIM_PKGETC" "$TRIM_PKGVAR"; do require_trusted_path "$task_path" || trust_fail; done
for task_path in "$pidfile" "$TRIM_PKGVAR/service.log" "$TRIM_PKGETC/config.json"; do require_optional_regular "$task_path" || trust_fail; done
is_running() {
  [[ -f "$pidfile" && ! -L "$pidfile" ]] || return 1
  local pid
  read -r pid <"$pidfile"
  [[ "$pid" =~ ^[1-9][0-9]*$ && -r "/proc/$pid/cmdline" ]] || return 1
  [[ "$(readlink -f -- "/proc/$pid/exe")" == "$(readlink -f -- "$binary")" ]] || return 1
  local -a arguments
  mapfile -d '' -t arguments <"/proc/$pid/cmdline"
  [[ "${arguments[1]:-}" == supervise ]] || return 1
  kill -0 "$pid" 2>/dev/null
}
fail() {
  echo "$1" >&2
  if [[ -n "${TRIM_TEMP_LOGFILE:-}" ]]; then echo "$1" >"$TRIM_TEMP_LOGFILE"; fi
  exit 1
}
case "${1:-}" in
  start)
    if is_running; then exit 0; fi
    [[ -f "$TRIM_PKGETC/config.json" ]] || fail '终端配置缺失，请重新安装应用。'
    nohup "$binary" supervise --config "$TRIM_PKGETC/config.json" --app-user "$TRIM_USERNAME" --gateway-socket "$TRIM_APPDEST/app.sock" --broker-socket "$TRIM_PKGETC/broker.sock" >>"$TRIM_PKGVAR/service.log" 2>&1 </dev/null &
    task_pid=$!
    printf '%s\n' "$task_pid" >"$pidfile"
    sleep 1
    is_running || fail '终端启动失败，请查看应用日志并检查安装路径权限。'
    ;;
  stop)
    if is_running; then
      read -r task_pid <"$pidfile"
      kill -TERM "$task_pid"
      for ((task_try = 0; task_try < 100; task_try++)); do
        if ! is_running; then break; fi
        sleep 0.1
      done
      if is_running; then fail '终端未能正常停止；为避免遗留会话，请检查服务日志。'; fi
    fi
    if [[ -f "$pidfile" && ! -L "$pidfile" ]]; then unlink "$pidfile"; fi
    ;;
  status) if is_running; then exit 0; else exit 3; fi ;;
  *) exit 1 ;;
esac
