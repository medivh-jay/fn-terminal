{
  "name": "fn-terminal-web",
  "private": true,
  "version": "0.1.14",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.mjs",
    "build": "npm run check && vite build",
    "format": "bash ../scripts/format.sh",
    "format:check": "bash ../scripts/format.sh --check"
  },
  "dependencies": {
    "@trimjs/web-app": "0.5.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
